{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/produtos", "rewrite": "/produtos.html" },
    { "route": "/index.html", "redirect": "/", "statusCode": 301 },

    {
      "route": "/imagens/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.css",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.js",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "route": "/",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/imagens/*", "/*.css", "/*.js", "/*.json", "/*.xml", "/*.txt"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=(), interest-cohort=()",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; object-src 'none'"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json",
    ".webp": "image/webp"
  }
}
